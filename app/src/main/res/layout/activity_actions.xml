<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ActionsActivity">

    <!-- Indicador de estado de conexión -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Conectado a ESP32"
        android:textColor="#4CAF50"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <!-- 1. Encendido / Apagado -->
    <Switch
        android:id="@+id/switchPower"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado de los LEDs"
        android:textSize="18sp"
        android:layout_marginBottom="32dp"/>

    <!-- 2. Intensidad (PWM 0% - 100%) -->
    <TextView
        android:id="@+id/tvIntensityLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Intensidad: 50%"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <SeekBar
        android:id="@+id/seekBarIntensity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="50"
        android:layout_marginBottom="32dp"/>

    <!-- 3. Sistema de botones para colores RGB -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selección de Color"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:columnCount="3"
        android:rowCount="2"
        android:layout_marginBottom="32dp">

        <Button
            android:id="@+id/btnColorRed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rojo"
            android:backgroundTint="#F44336"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/btnColorGreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verde"
            android:backgroundTint="#4CAF50"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/btnColorBlue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Azul"
            android:backgroundTint="#2196F3"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/btnColorYellow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amar"
            android:backgroundTint="#FFEB3B"
            android:textColor="#000000"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/btnColorPurple"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mora"
            android:backgroundTint="#9C27B0"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/btnColorWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blan"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000"
            android:layout_margin="4dp"/>
    </GridLayout>

    <!-- Espaciador para empujar el botón de desconexión al fondo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Botón para desconectar y volver al Login -->
    <Button
        android:id="@+id/btnDisconnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Desconectar"
        android:backgroundTint="#F44336"/>

</LinearLayout>